# ────────────────────────────────────────────
# Veritas Research — Environment Variables
# Copy to .env and fill in your values
# ────────────────────────────────────────────

# ── Google Gemini AI ────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FLASH_MODEL=gemini-1.5-flash
GEMINI_PRO_MODEL=gemini-1.5-pro

# ── Tavily Search ─────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── Database ──────────────────────────────────
# SQLite (development — works out of the box)
DATABASE_URL=sqlite+aiosqlite:///./veritas.db

# PostgreSQL (production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/veritas

# Supabase (hosted PostgreSQL)
# DATABASE_URL=postgresql+asyncpg://postgres:[password]@[host].supabase.co:5432/postgres
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Frontend ──────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── App Settings ──────────────────────────────
DEBUG=false
FRONTEND_URL=http://localhost:3000

# ── Optional Local NLP ────────────────────────
USE_LOCAL_NLP=false
