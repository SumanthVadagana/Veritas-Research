{
  "name": "veritas-research",
  "version": "1.0.0",
  "private": true,
  "description": "Autonomous Multi-Agent Research & Fact-Verification System",
  "scripts": {
    "dev": "npx concurrently -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && uvicorn app.main:app --reload --port 8000",
    "build": "cd frontend && npm run build",
    "install:all": "npm run install:frontend && npm run install:backend",
    "install:frontend": "cd frontend && npm install",
    "install:backend": "cd backend && pip install -r requirements.txt",
    "setup": "cp .env.example .env && npm run install:all"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
